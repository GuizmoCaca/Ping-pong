<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ping Pong - Jeu en JavaScript</title>
    <style>
        body {
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: #222;
            font-family: Arial, sans-serif;
            color: white;
            overflow: hidden;
        }
        canvas {
            background: #000;
            border: 2px solid #444;
        }
        #score {
            position: absolute;
            top: 20px;
            font-size: 24px;
        }
        #instructions {
            position: absolute;
            bottom: 20px;
            font-size: 14px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div id="score">0 - 0</div>
    <div id="instructions">
        Joueur 1 : Z (haut) / Q (bas) | Joueur 2 : ↑ (haut) / ↓ (bas)
    </div>
    <canvas id="gameCanvas" width="800" height="400"></canvas>

    <script>
        // Récupération du canvas et du contexte
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreElement = document.getElementById('score');

        // Variables du jeu
        let score1 = 0;
        let score2 = 0;
        const paddleHeight = 100;
        const paddleWidth = 15;
        const ballSize = 15;
        let ballSpeedX = 5;
        let ballSpeedY = 5;

        // Positions initiales
        const paddle1 = {
            x: 20,
            y: canvas.height / 2 - paddleHeight / 2,
            width: paddleWidth,
            height: paddleHeight,
            speed: 8,
            upKey: 'z',
            downKey: 'q'
        };

        const paddle2 = {
            x: canvas.width - 20 - paddleWidth,
            y: canvas.height / 2 - paddleHeight / 2,
            width: paddleWidth,
            height: paddleHeight,
            speed: 8,
            upKey: 'ArrowUp',
            downKey: 'ArrowDown'
        };

        const ball = {
            x: canvas.width / 2,
            y: canvas.height / 2,
            size: ballSize,
            reset: function() {
                this.x = canvas.width / 2;
                this.y = canvas.height / 2;
                ballSpeedX = (Math.random() > 0.5 ? 1 : -1) * 5;
                ballSpeedY = (Math.random() * 4 - 2);
            }
        };

        // Détection des touches pressées
        const keys = {};

        document.addEventListener('keydown', (e) => {
            keys[e.key] = true;
        });

        document.addEventListener('keyup', (e) => {
            keys[e.key] = false;
        });

        // Mise à jour des positions des raquettes
        function updatePaddles() {
            if (keys[paddle1.upKey] && paddle1.y > 0) {
                paddle1.y -= paddle1.speed;
            }
            if (keys[paddle1.downKey] && paddle1.y < canvas.height - paddle1.height) {
                paddle1.y += paddle1.speed;
            }
            if (keys[paddle2.upKey] && paddle2.y > 0) {
                paddle2.y -= paddle2.speed;
            }
            if (keys[paddle2.downKey] && paddle2.y < canvas.height - paddle2.height) {
                paddle2.y += paddle2.speed;
            }
        }

        // Mise à jour de la balle
        function updateBall() {
            ball.x += ballSpeedX;
            ball.y += ballSpeedY;

            // Rebond sur les bords haut/bas
            if (ball.y <= 0 || ball.y >= canvas.height) {
                ballSpeedY *= -1;
            }

            // Collision avec les raquettes
            if (
                ball.x <= paddle1.x + paddle1.width &&
                ball.y + ball.size >= paddle1.y &&
                ball.y <= paddle1.y + paddle1.height
            ) {
                ballSpeedX = Math.abs(ballSpeedX); // Rebond vers la droite
                // Ajout d'un effet de "coup" en fonction de la position de la raquette
                const hitPosition = (ball.y - paddle1.y) / paddle1.height;
                ballSpeedY = (hitPosition - 0.5) * 10;
            }

            if (
                ball.x + ball.size >= paddle2.x &&
                ball.y + ball.size >= paddle2.y &&
                ball.y <= paddle2.y + paddle2.height
            ) {
                ballSpeedX = -Math.abs(ballSpeedX); // Rebond vers la gauche
                const hitPosition = (ball.y - paddle2.y) / paddle2.height;
                ballSpeedY = (hitPosition - 0.5) * 10;
            }

            // Points marqués
            if (ball.x < 0) {
                score2++;
                ball.reset();
            }
            if (ball.x > canvas.width) {
                score1++;
                ball.reset();
            }
        }

        // Dessin du jeu
        function draw() {
            // Effacer le canvas
            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Dessiner le filet
            ctx.strokeStyle = '#444';
            ctx.beginPath();
            ctx.moveTo(canvas.width / 2, 0);
            ctx.lineTo(canvas.width / 2, canvas.height);
            ctx.stroke();

            // Dessiner les raquettes
            ctx.fillStyle = '#fff';
            ctx.fillRect(paddle1.x, paddle1.y, paddle1.width, paddle1.height);
            ctx.fillRect(paddle2.x, paddle2.y, paddle2.width, paddle2.height);

            // Dessiner la balle
            ctx.fillRect(ball.x, ball.y, ball.size, ball.size);

            // Mettre à jour le score
            scoreElement.textContent = `${score1} - ${score2}`;
        }

        // Boucle principale du jeu
        function gameLoop() {
            updatePaddles();
            updateBall();
            draw();
            requestAnimationFrame(gameLoop);
        }

        // Démarrer le jeu
        ball.reset();
        gameLoop();
    </script>
</body>
</html>
